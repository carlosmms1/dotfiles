# Copy this file to ~/.config/opencode/.env and fill the values.
# The file is sourced by ~/.zshrc and is intentionally ignored by git.
#
#   mkdir -p ~/.config/opencode
#   cp .env.example ~/.config/opencode/.env
#   chmod 600 ~/.config/opencode/.env
#
# Never commit the real .env file.

# GitHub MCP (fine-grained PAT with the toolsets below)
export GITHUB_PERSONAL_ACCESS_TOKEN=

# Neon MCP (used by ~/.config/opencode/opencode.jsonc)
export NEON_API_KEY=

# Langfuse observability plugin
export LANGFUSE_PUBLIC_KEY=
export LANGFUSE_SECRET_KEY=
export LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Plane MCP (if you use the token-backed setup)
export PLANE_API_TOKEN=
